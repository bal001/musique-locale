{
  "name": "youtube-musique-locale",
  "version": "1.0.0",
  "private": true,
  "description": "Clone local de YouTube Music, reconstruit à partir de l'analyse REA, qui lit vos propres fichiers audio.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "vite build && node server/index.mjs",
    "serveur": "node server/index.mjs",
    "demo": "node server/demo.mjs --force",
    "typecheck": "tsc --noEmit",
    "app": "node scripts/creer-app.mjs",
    "electron": "vite build && electron electron/principal.mjs"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "express": "^5.3.0",
    "music-metadata": "^12.2.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
